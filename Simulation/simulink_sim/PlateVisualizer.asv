classdef PlateVisualizer < matlab.System
    % Live 3D Plate, Ball, and Actuator Visualizer for 5SC26 Setup
    properties (Access = private)
        XDataOrig
        YDataOrig
        ZDataOrig
        JointsOrig % Hardcoded local joint offsets on the plate
    end
    methods (Access = protected)
        function setupImpl(obj)
            % Declare graphic functions as extrinsic
            coder.extrinsic('figure', 'axes', 'patch', 'line', 'grid', 'view', 'axis', 'xlabel', 'ylabel', 'zlabel', 'title', 'daspect', 'assignin');
            
            % Initialize the variable in the base workspace at startup so it always exists
            assignin('base', 'outer_loop_enable', 0);
            assignin('base', 'inner_loop_enable', 0);
            
            % Define a 400x400 mm square plate centered at (0,0)
            L = 0.400 / 2; 
            obj.XDataOrig = [-L,  L, L, -L];
            obj.YDataOrig = [-L, -L, L,  L];
            obj.ZDataOrig = [ 0,  0, 0,  0]; 
            
            % Define local actuator joint layouts based on physical rig dimensions
            r = 0.17; % Joint layout radius (meters)
            theta = deg2rad(120);
            obj.JointsOrig = [r, r*cos(theta),  r*cos(theta); ...
                              0, r*sin(theta), -r*sin(theta); ...
                              0, 0,             0];
            
            % Open the 3D window
            figure('Name', 'Live Ball & Plate 3D View', 'NumberTitle', 'off', 'Tag', 'PlateSimWindow');
            ax = axes('Parent', gcf);
            
            % Draw the fixed ground platform reference at z = -0.05m
            patch(ax, 'XData', obj.XDataOrig, 'YData', obj.YDataOrig, 'ZData', obj.ZDataOrig - 0.05, ...
                     'FaceColor', [0.4 0.4 0.4], 'FaceAlpha', 0.3, 'EdgeColor', 'none', 'Tag', 'GroundPlatform');
            
            % Draw the 3 physical vertical actuators (Initialized as flat lines)
            line([r; r], [0; 0], [-0.05; 0], 'Parent', ax, 'Color', [0.2 0.6 0.8], 'LineWidth', 4, 'Tag', 'ActuatorA');
            line([obj.JointsOrig(1,2); obj.JointsOrig(1,2)], [obj.JointsOrig(2,2); obj.JointsOrig(2,2)], [-0.05; 0], 'Parent', ax, 'Color', [0.2 0.6 0.8], 'LineWidth', 4, 'Tag', 'ActuatorB');
            line([obj.JointsOrig(1,3); obj.JointsOrig(1,3)], [obj.JointsOrig(2,3); obj.JointsOrig(2,3)], [-0.05; 0], 'Parent', ax, 'Color', [0.2 0.6 0.8], 'LineWidth', 4, 'Tag', 'ActuatorC');
            
            % Draw the plate patch
            patch(ax, 'XData', obj.XDataOrig, 'YData', obj.YDataOrig, 'ZData', obj.ZDataOrig, ...
                     'FaceColor', [0.9 0.9 0.9], 'EdgeColor', 'k', 'LineWidth', 1.5, 'Tag', 'PlatePatch');
            
            % Draw the ball marker
            line(0, 0, 0, 'Parent', ax, 'Marker', 'o', 'MarkerSize', 12, ...
                 'MarkerFaceColor', 'k', 'MarkerEdgeColor', 'k', 'Tag', 'BallMarker');
            
            % Configure view layout
            grid(ax, 'on');
            view(ax, 3); 
            axis(ax, [-0.25 0.25 -0.25 0.25 -0.08 0.08]);
            xlabel(ax, 'X (m)'); ylabel(ax, 'Y (m)'); zlabel(ax, 'Z (m)');
            title(ax, 'System Simulation Model');
            daspect(ax, [1 1 1]); 
            
            % Create extrinsic UI controls on the active figure window
            coder.extrinsic('uicontrol');
            
            % Reset Button
            resetCmd = 'assignin(''base'', ''sim_reset'', 1); pause(0.05); assignin(''base'', ''sim_reset'', 0);';
            uicontrol('Parent', gcf, 'Style', 'pushbutton', ...
                      'String', 'Reset Ball to Center', ...
                      'Position', [20 20 140 30], ... 
                      'Callback', resetCmd);
                  
            % Toggle Switch for Outer Loop Enable
            toggleCmd = 'assignin(''base'', ''outer_loop_enable'', get(gcbo, ''Value''));';
            uicontrol('Parent', gcf, 'Style', 'togglebutton', ...
                      'String', 'Outer Loop OFF', ...
                      'Position', [180 20 140 30], ... 
                      'Callback', toggleCmd, ...
                      'Tag', 'OuterLoopToggle');

            % Toggle Switch for Outer Loop Enable
            toggleCmd = 'assignin(''base'', ''inner_loop_enable'', get(gcbo, ''Value''));';
            uicontrol('Parent', gcf, 'Style', 'togglebutton', ...
                      'String', 'inner Loop OFF', ...
                      'Position', [180 20 140 30], ... 
                      'Callback', toggleCmd, ...
                      'Tag', 'InnerLoopToggle');
        end
        
        function stepImpl(obj, alpha, beta, x_ball, y_ball)
            % Declare runtime graphic functions as extrinsic
            coder.extrinsic('findobj', 'set', 'drawnow', 'evalin');
            
            % Pre-define loop_state as a standard double so the compiler knows its type
            loop_state = 0.0;
            
            % Read loop state from base workspace into our pre-defined type
            loop_state = evalin('base', 'outer_loop_enable');
            
            hToggle = findobj('Tag', 'OuterLoopToggle');
            if ~isempty(hToggle)
                if loop_state == 1
                    set(hToggle, 'String', 'Outer Loop ON', 'BackgroundColor', [0.6 1.0 0.6]);
                else
                    set(hToggle, 'String', 'Outer Loop OFF', 'BackgroundColor', [1.0 0.6 0.6]);
                end
            end

            hToggle2 = findobj('Tag', 'InnerLoopToggle');
            if ~isempty(hToggle2)
                if loop_state == 1
                    set(hToggle2, 'String', 'Inner Loop ON', 'BackgroundColor', [0.6 1.0 0.6]);
                else
                    set(hToggle2, 'String', 'Inner Loop OFF', 'BackgroundColor', [1.0 0.6 0.6]);
                end
            end
            
            % Compute rotation matrices for Tait-Bryan angles
            Rx = [1, 0, 0; 0, cos(beta), -sin(beta); 0, sin(beta), cos(beta)];
            Ry = [cos(alpha), 0, sin(alpha); 0, 1, 0; -sin(alpha), 0, cos(alpha)];
            R = Ry * Rx; 
            
            % 1. Rotate the plate patch corners
            orig_coords = [obj.XDataOrig; obj.YDataOrig; obj.ZDataOrig];
            rot_coords = R * orig_coords;
            
            % 2. Rotate the physical joint locations
            rot_joints = R * obj.JointsOrig;
            
            % 3. Calculate the ball's 3D height matching the tilted plane
            nx = R(1,3); ny = R(2,3); nz = R(3,3);
            if abs(nz) > 1e-5
                z_ball = -(nx * x_ball + ny * y_ball) / nz;
            else
                z_ball = 0;
            end
            z_ball = z_ball + 0.012; 
            
            % --- Update Graphic Object Properties Live ---
            hPatch = findobj('Tag', 'PlatePatch');
            if ~isempty(hPatch)
                set(hPatch, 'XData', rot_coords(1,:), 'YData', rot_coords(2,:), 'ZData', rot_coords(3,:));
            end
            
            hBall = findobj('Tag', 'BallMarker');
            if ~isempty(hBall)
                set(hBall, 'XData', x_ball, 'YData', y_ball, 'ZData', z_ball);
            end
            
            % Update Actuator columns
            hActA = findobj('Tag', 'ActuatorA');
            if ~isempty(hActA)
                set(hActA, 'XData', [obj.JointsOrig(1,1); rot_joints(1,1)], 'YData', [obj.JointsOrig(2,1); rot_joints(2,1)], 'ZData', [-0.05; rot_joints(3,1)]);
            end
            hActB = findobj('Tag', 'ActuatorB');
            if ~isempty(hActB)
                set(hActB, 'XData', [obj.JointsOrig(1,2); rot_joints(1,2)], 'YData', [obj.JointsOrig(2,2); rot_joints(2,2)], 'ZData', [-0.05; rot_joints(3,2)]);
            end
            hActC = findobj('Tag', 'ActuatorC');
            if ~isempty(hActC)
                set(hActC, 'XData', [obj.JointsOrig(1,3); rot_joints(1,3)], 'YData', [obj.JointsOrig(2,3); rot_joints(2,3)], 'ZData', [-0.05; rot_joints(3,3)]);
            end
            
            drawnow limitrate;
        end
        
        function releaseImpl(~)
            coder.extrinsic('findobj', 'close');
            hFig = findobj('Tag', 'PlateSimWindow');
            if ~isempty(hFig)
                close(hFig);
            end
        end
        
        function num = getNumInputsImpl(~)
            num = 4; 
        end
    end
end